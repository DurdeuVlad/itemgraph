{
  "schema_version": 1,
  "compatibility_version": "m8.1.0",
  "mod_id": "itemgraph",
  "supported_commands": ["/ig", "/itemgraph"],
  "unsupported_aliases": ["/gl", "/grieflogger"],
  "source": {
    "name": "GriefLogger",
    "documentation": "https://daqem.com/projects/grieflogger",
    "database_policy": "read_only"
  },
  "statuses": ["compatible", "extended", "unsupported", "unresolved"],
  "evidence_classes": ["observed", "inferred", "ambiguous", "unresolved"],
  "versioning": {
    "compatibility_version_changes_when": [
      "a published GriefLogger action, filter, permission, page, inspector behavior, configuration control, or storage contract changes mapping",
      "an existing ItemGraph mapping changes status or evidence/quantity semantics",
      "a supported loader or backend changes without preserving the previous contract"
    ],
    "patch_changes": "documentation-only clarifications that do not change behavior",
    "minor_changes": "new compatible or extended entries with existing semantics preserved",
    "major_changes": "renamed, removed, or semantically incompatible mappings",
    "owner": "ItemGraph maintainers",
    "review_requirement": "update this registry, docs/GRIEFLOGGER_PARITY.md, and the owning GitHub issue in the same change"
  },
  "actions": [
    {"grieflogger": "ADD_ITEM", "itemgraph": "ADD_ITEM", "status": "compatible", "evidence_class": "observed", "quantity": "signed_delta", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "REMOVE_ITEM", "itemgraph": "REMOVE_ITEM", "status": "compatible", "evidence_class": "observed", "quantity": "signed_delta", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "DROP_ITEM", "itemgraph": "DROP_ITEM", "status": "compatible", "evidence_class": "observed", "quantity": "signed_delta", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "PICKUP_ITEM", "itemgraph": "PICKUP_ITEM", "status": "compatible", "evidence_class": "observed", "quantity": "signed_delta", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "CRAFT_ITEM", "itemgraph": "CRAFT", "status": "extended", "evidence_class": "observed", "quantity": "transformation", "loaders": ["fabric", "neoforge"], "compatibility_note": "ItemGraph preserves transformation lineage and source/result fingerprints."},
    {"grieflogger": "CONSUME_ITEM", "itemgraph": "CONSUME_ITEM", "status": "compatible", "evidence_class": "observed", "quantity": "signed_delta", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "BREAK_ITEM", "itemgraph": "BREAK_ITEM", "status": "compatible", "evidence_class": "observed", "quantity": "signed_delta", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "THROW_ITEM", "itemgraph": "THROW_ITEM", "status": "unresolved", "evidence_class": "observed", "quantity": "non_quantity_projectile_evidence", "loaders": ["fabric", "neoforge"], "owner_issue": 27, "compatibility_note": "ItemGraph currently records projectile spawn evidence without claiming a quantity transfer; GriefLogger's item-usage row includes item/count semantics."},
    {"grieflogger": "SHOOT_ITEM", "itemgraph": "SHOOT_ITEM", "status": "unresolved", "evidence_class": "observed", "quantity": "non_quantity_projectile_evidence", "loaders": ["fabric", "neoforge"], "owner_issue": 27, "compatibility_note": "ItemGraph currently records projectile spawn evidence without claiming a quantity transfer; GriefLogger's item-usage row includes item/count semantics."},
    {"grieflogger": "PLACE_BLOCK", "itemgraph": "PLACE_BLOCK", "status": "compatible", "evidence_class": "observed", "quantity": "none", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "BREAK_BLOCK", "itemgraph": "BREAK_BLOCK", "status": "compatible", "evidence_class": "observed", "quantity": "none", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "INTERACT_BLOCK", "itemgraph": "INTERACT_BLOCK_ATTEMPT", "status": "unresolved", "evidence_class": "observed", "quantity": "none", "loaders": ["fabric", "neoforge"], "owner_issue": 27},
    {"grieflogger": "KILL_ENTITY", "itemgraph": "KILL_ENTITY", "status": "compatible", "evidence_class": "observed", "quantity": "none", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "JOIN", "itemgraph": "PLAYER_JOIN", "status": "compatible", "evidence_class": "observed", "quantity": "none", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "QUIT", "itemgraph": "PLAYER_QUIT", "status": "compatible", "evidence_class": "observed", "quantity": "none", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "CHAT", "itemgraph": "CHAT_MESSAGE", "status": "compatible", "evidence_class": "observed", "quantity": "none", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "COMMAND", "itemgraph": "COMMAND_ATTEMPT", "status": "compatible", "evidence_class": "observed", "quantity": "none", "loaders": ["fabric", "neoforge"]},
    {"grieflogger": "SMELT", "itemgraph": "SMELT", "status": "extended", "evidence_class": "observed", "quantity": "transformation", "loaders": ["fabric", "neoforge"], "compatibility_note": "ItemGraph preserves transformation lineage and source/result fingerprints."},
    {"grieflogger": "ANVIL_RENAME", "itemgraph": "ANVIL_RENAME", "status": "extended", "evidence_class": "observed", "quantity": "transformation", "loaders": ["fabric", "neoforge"], "compatibility_note": "ItemGraph preserves transformation lineage and source/result fingerprints."},
    {"grieflogger": null, "itemgraph": "HOPPER_INSERT", "status": "extended", "evidence_class": "observed", "quantity": "signed_delta", "loaders": ["fabric", "neoforge"], "compatibility_note": "Supplemental automation evidence with unknown endpoints; GriefLogger does not publish an equivalent hopper action."},
    {"grieflogger": null, "itemgraph": "HOPPER_EXTRACT", "status": "extended", "evidence_class": "observed", "quantity": "signed_delta", "loaders": ["fabric", "neoforge"], "compatibility_note": "Supplemental automation evidence with unknown endpoints; GriefLogger does not publish an equivalent hopper action."}
  ],
  "filters": {
    "names": ["action", "a", "user", "u", "include", "i", "exclude", "e", "time", "t", "radius", "r"],
    "maximum": 5,
    "radius_required": true,
    "combination": "and",
    "time_units": ["m", "h", "d", "y"],
    "include_exclude_mutually_exclusive": true,
    "value_separator": ","
  },
  "controls": {
    "permission_level": 2,
    "page_size_maximum": 100,
    "query_worker_queue_maximum": 64,
    "ingestion_queue_maximum": 10000,
    "entityless_query_timeout_seconds": 5,
    "lookup_page": {
      "standalone_command": "/ig page <number>",
      "session_scoped": true,
      "one_based": true,
      "previous_next_actions": true
    },
    "inspect": {
      "toggle_command": "/ig inspect",
      "status_command": "/ig inspect status",
      "permission_level": 2,
      "suppresses_gameplay_actions_while_enabled": true,
      "targets": ["block_left_click", "functional_block_right_click", "container", "double_chest", "door"]
    }
  },
  "configuration_controls": [
    {"grieflogger": "useMysql", "itemgraph": "storage.backend", "status": "unresolved", "implementation_state": "planned", "owner_issue": 29},
    {"grieflogger": "mysqlHost", "itemgraph": "storage.mysql.host", "status": "unresolved", "implementation_state": "planned", "owner_issue": 29},
    {"grieflogger": "mysqlPort", "itemgraph": "storage.mysql.port", "status": "unresolved", "implementation_state": "planned", "owner_issue": 29},
    {"grieflogger": "mysqlDatabase", "itemgraph": "storage.mysql.database", "status": "unresolved", "implementation_state": "planned", "owner_issue": 29},
    {"grieflogger": "mysqlUsername", "itemgraph": "storage.mysql.username", "status": "unresolved", "implementation_state": "planned", "owner_issue": 29},
    {"grieflogger": "mysqlPassword", "itemgraph": "storage.mysql.password", "status": "unresolved", "implementation_state": "planned", "owner_issue": 29, "redacted": true},
    {"grieflogger": "mysqlTimeout", "itemgraph": "storage.connection_timeout", "status": "unresolved", "implementation_state": "planned", "owner_issue": 29},
    {"grieflogger": "useIndexes", "itemgraph": "storage.index_policy", "status": "unresolved", "implementation_state": "planned", "owner_issue": 29},
    {"grieflogger": "maxPageSize", "itemgraph": "query.max_page_size", "status": "unresolved", "implementation_state": "planned", "owner_issue": 30},
    {"grieflogger": "serverSideOnlyMode", "itemgraph": "server_side_only", "status": "unresolved", "implementation_state": "planned", "owner_issue": 30},
    {"grieflogger": "queueFrequency", "itemgraph": "ingestion.queue_frequency", "status": "unresolved", "implementation_state": "planned", "owner_issue": 30},
    {"grieflogger": "helloFrequency", "itemgraph": "operations.hello_frequency", "status": "unresolved", "implementation_state": "planned", "owner_issue": 30}
  ],
  "inspector_behavior": [
    {"grieflogger": "left_click_block_history", "itemgraph": "block_left_click_history", "status": "unresolved", "implementation_state": "planned", "owner_issue": 26},
    {"grieflogger": "right_click_functional_block_history", "itemgraph": "functional_block_right_click_history", "status": "unresolved", "implementation_state": "planned", "owner_issue": 26},
    {"grieflogger": "container_history", "itemgraph": "container_history", "status": "compatible", "owner_issue": 26},
    {"grieflogger": "double_chest_history", "itemgraph": "double_chest_history", "status": "unresolved", "implementation_state": "planned", "owner_issue": 26},
    {"grieflogger": "door_history", "itemgraph": "door_history", "status": "unresolved", "implementation_state": "planned", "owner_issue": 26}
  ],
  "extensions": [
    {"itemgraph": "transformation_lineage", "status": "extended", "evidence_class": "observed", "quantity": "transformation", "loaders": ["fabric", "neoforge"], "compatibility_note": "Supplemental source/result fingerprints and lineage metadata for CRAFT, SMELT, and ANVIL_RENAME."}
  ],
  "storage": {
    "native": ["sqlite"],
    "planned": ["mysql", "mariadb"],
    "grieflogger_database_mutation": false
  },
  "owner_issues": {
    "contract": 23,
    "commands": 24,
    "lookup": 25,
    "inspector": 26,
    "native_events": 27,
    "historical_import": 28,
    "storage": 29,
    "operations": 30,
    "differential_proof": 31
  }
}
